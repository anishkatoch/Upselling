{
  "transcript": {
    "duration": 331.310938,
    "segments": [
      {
        "id": 0,
        "speaker": "A",
        "start": 0.0,
        "end": 3.3999999999999995,
        "text": "namaste sir, bataiye kya dikhaun?"
      },
      {
        "id": 1,
        "speaker": "B",
        "start": 3.999999999999999,
        "end": 10.05,
        "text": "ye jo chauda hazaar nauso ninyanve wala phone laga hai, iska neela rang milega?"
      },
      {
        "id": 2,
        "speaker": "A",
        "start": 11.15,
        "end": 18.8,
        "text": "ji, neela hai. yahi chhah gb ram aur ek sau athais gb storage wala hai. nikaldu?"
      },
      {
        "id": 3,
        "speaker": "B",
        "start": 19.45,
        "end": 23.8,
        "text": "haan, iske dibbe mein charger aur cover dono aate hain kya?"
      },
      {
        "id": 4,
        "speaker": "A",
        "start": 25.358,
        "end": 30.758000000000003,
        "text": "charger aata hai, sir, cover nahi aata; phone, charger aur cable hai andar."
      },
      {
        "id": 5,
        "speaker": "B",
        "start": 32.008,
        "end": 36.608000000000004,
        "text": "theek hai, yahi phone de dijiye, bill mere naam se banana."
      },
      {
        "id": 6,
        "speaker": "A",
        "start": 37.558,
        "end": 47.408,
        "text": "sir, iske saath ye cover bhi laga doon. chaar sau ninyanve ka hai, kinaron par achhi pakar hai aur camere ke aaspaas bhi thoda utha hua hai."
      },
      {
        "id": 7,
        "speaker": "B",
        "start": 48.458000000000006,
        "end": 52.554,
        "text": "nahi, cover nahi chahiye. abhi bas phone lena hai"
      },
      {
        "id": 8,
        "speaker": "A",
        "start": 53.104,
        "end": 61.754000000000005,
        "text": "phone ke saath lenge to yahi cover do sau ninyanve mein de doonga sir. alag se lene par poori keemat lagegi."
      },
      {
        "id": 9,
        "speaker": "B",
        "start": 62.404,
        "end": 68.554,
        "text": "nahi, bhaiya, rehne dijiye, maine bola na sirf phone chahiye"
      },
      {
        "id": 10,
        "speaker": "A",
        "start": 69.35400000000001,
        "end": 71.304,
        "text": "ji sir, maaf kijiye,"
      },
      {
        "id": 11,
        "speaker": "A",
        "start": 72.10400000000001,
        "end": 77.754,
        "text": "sirf phone ka bill bana raha hoon, kul chauda hazaar nau sau ninyanve rupaye hai"
      },
      {
        "id": 12,
        "speaker": "B",
        "start": 78.108,
        "end": 84.408,
        "text": "naam amit sharma daal dijiye. bhuktaan upi se kar doonga."
      },
      {
        "id": 13,
        "speaker": "A",
        "start": 85.458,
        "end": 96.25800000000001,
        "text": "is code par kar dijiye. haan, bhuktaan aa gaya ye aapka bill hai ab aapke saamne dibba khol kar phone check karwa deta hoon"
      },
      {
        "id": 14,
        "speaker": "B",
        "start": 96.75800000000001,
        "end": 101.50800000000001,
        "text": "haan khol dijiye, screen aur camera ek baar dekh loonga."
      },
      {
        "id": 15,
        "speaker": "A",
        "start": 109.89800000000001,
        "end": 110.548,
        "text": "haan ji,"
      },
      {
        "id": 16,
        "speaker": "A",
        "start": 111.64800000000001,
        "end": 114.248,
        "text": "bataiye kya chahiye?"
      },
      {
        "id": 17,
        "speaker": "B",
        "start": 115.19800000000001,
        "end": 120.548,
        "text": "laptop ke liye ek basic wired mouse chahiye-paanch sau ke andar dikhana."
      },
      {
        "id": 18,
        "speaker": "A",
        "start": 121.44800000000001,
        "end": 128.348,
        "text": "ye wala chaura chaura nau ka hai u s bhi lagaoge to seedha chal jayega set ap ka kuch nahi hai"
      },
      {
        "id": 19,
        "speaker": "B",
        "start": 129.198,
        "end": 132.398,
        "text": "haan, theek hai, yahin pack kar do."
      },
      {
        "id": 20,
        "speaker": "A",
        "start": 133.59599999999998,
        "end": 141.946,
        "text": "taak kar deta hoon; lekin ek baar ye ek nau nau wala wireless dekh lo, cable ka jhanjhat nahi rahega, grip bhi better hai"
      },
      {
        "id": 21,
        "speaker": "B",
        "start": 143.696,
        "end": 151.896,
        "text": "nahi, wireless nahi chahiye, budget bola na, paanchso. achha, wired hi sahi,"
      },
      {
        "id": 22,
        "speaker": "B",
        "start": 152.74599999999998,
        "end": 154.24599999999998,
        "text": "saath mein mousepad rakh doon,"
      },
      {
        "id": 23,
        "speaker": "B",
        "start": 155.046,
        "end": 163.82999999999998,
        "text": "van ninety nine ka hai, table pe scratches bhi nahi aayenge. pad ghar pe hai-sirf maus ka bill bana do-jaldi hai"
      },
      {
        "id": 24,
        "speaker": "A",
        "start": 164.28,
        "end": 173.38,
        "text": "ek minute, ki board-mouse combo bhi hai ek hazaar do sau tiranve ka alag alag lene se sasta padta hai mouse ki jagah poora combo kar doon?"
      },
      {
        "id": 25,
        "speaker": "B",
        "start": 174.23,
        "end": 179.48,
        "text": "ki board chahiye hi nahi mujhe-aap chaar so chalis wale ka bill kyun nahi bana rahe?"
      },
      {
        "id": 26,
        "speaker": "A",
        "start": 180.444,
        "end": 193.044,
        "text": "Bana raha hoon, sir; bus wireless wale ke do piece bache hain; offer aaj tak hi hai; abhi aath so air tone mein laga doonga, baad mein ye rate nahin milega."
      },
      {
        "id": 27,
        "speaker": "A",
        "start": 194.094,
        "end": 200.594,
        "text": "Arey, kitni baar boloon, mujhe wireless nahin lena, bus jo select kiya hai, woh de do."
      },
      {
        "id": 28,
        "speaker": "A",
        "start": 201.44400000000002,
        "end": 211.402,
        "text": "Theek hai, chhauso battalis wala hi, uspe ninety nine ki extended warranty add kar do. Ek saar ki extra coverage mil jaayegi, kaam aati hai."
      },
      {
        "id": 29,
        "speaker": "B",
        "start": 211.75199999999998,
        "end": 220.202,
        "text": "nahi kuch bhi extra mat jodna. aap sun kyun nahi rahe? ab bill bana do warna main ja raha hoon"
      },
      {
        "id": 30,
        "speaker": "A",
        "start": 222.302,
        "end": 230.50199999999998,
        "text": "Sorry, sir, sirf wired mouse total four forty nine. Koi extra charge nahi. Ye raha bill, upi yahan kar dijiye."
      },
      {
        "id": 31,
        "speaker": "B",
        "start": 230.902,
        "end": 237.036,
        "text": "kar diya, mouse aur bill de do. ek cheez lene mein itna time laga diya."
      },
      {
        "id": 32,
        "speaker": "B",
        "start": 244.686,
        "end": 247.436,
        "text": "ji, bataiye kya chahiye?"
      },
      {
        "id": 33,
        "speaker": "A",
        "start": 248.686,
        "end": 255.436,
        "text": "laptop ke liye ek saadharan wired u sb mouse chahiye teen sau rupaye tak ka hai"
      },
      {
        "id": 34,
        "speaker": "B",
        "start": 256.636,
        "end": 257.036,
        "text": "ji!"
      },
      {
        "id": 35,
        "speaker": "B",
        "start": 258.51,
        "end": 263.71,
        "text": "ye wala dhai sau ka hai, wired hai, u s bee mein laga kar seedhe chala sakte hain."
      },
      {
        "id": 36,
        "speaker": "A",
        "start": 264.46,
        "end": 266.65999999999997,
        "text": "ek baar haath mein le kar dekh lo,"
      },
      {
        "id": 37,
        "speaker": "A",
        "start": 267.51,
        "end": 269.36,
        "text": "size zyada chhota to nahi hai?"
      },
      {
        "id": 38,
        "speaker": "B",
        "start": 270.31,
        "end": 274.86,
        "text": "haan ji, ye display wala dekh lijiye, isi model ka hai."
      },
      {
        "id": 39,
        "speaker": "A",
        "start": 275.36,
        "end": 278.96,
        "text": "size theek hai, ise chala kar bhi dikha denge?"
      },
      {
        "id": 40,
        "speaker": "A",
        "start": 280.43,
        "end": 286.33,
        "text": "Bilkul. Is laptop mein laga deta hoon. Aap click aur scroll karke dekh lijiye."
      },
      {
        "id": 41,
        "speaker": "A",
        "start": 287.18,
        "end": 292.03000000000003,
        "text": "Haa! Sahi chal raha hai. Iski warranty kitni hai?"
      },
      {
        "id": 42,
        "speaker": "A",
        "start": 293.03000000000003,
        "end": 295.88,
        "text": "Ek saal ki company warranty hai."
      },
      {
        "id": 43,
        "speaker": "A",
        "start": 296.68,
        "end": 298.23,
        "text": "Bill sambhal kar rakhiyega."
      },
      {
        "id": 44,
        "speaker": "A",
        "start": 299.08000000000004,
        "end": 309.394,
        "text": "Theek hai, yahi pack kar dijiye. Bill bhi bana dijiye. Ji, naya seal band piece ye raha. kul dhai sau rupaye hue"
      },
      {
        "id": 45,
        "speaker": "A",
        "start": 310.29400000000004,
        "end": 313.04400000000004,
        "text": "ye lijiye dhai sau"
      },
      {
        "id": 46,
        "speaker": "C",
        "start": 313.79400000000004,
        "end": 314.144,
        "text": "ji,"
      },
      {
        "id": 47,
        "speaker": "C",
        "start": 314.994,
        "end": 318.944,
        "text": "paise mil gaye; ye aapka mouse aur bill ..."
      },
      {
        "id": 48,
        "speaker": "A",
        "start": 320.29400000000004,
        "end": 322.744,
        "text": "theek hai, dhanyavaad."
      }
    ],
