{
  "transcript": {
    "duration": 276.75,
    "segments": [
      {
        "id": 0,
        "speaker": "A",
        "start": 0.0,
        "end": 9.65,
        "text": "جی بتائیے کیا چاہیے؟ لاجیٹیک کا بی ینسو بائرڈ ماؤس ہے؟ بلیک کلر میں چاہیے"
      },
      {
        "id": 1,
        "speaker": "A",
        "start": 10.8,
        "end": 23.400000000000002,
        "text": "ہاں جی بلیک آویلیبل ہے ایک پیس چاہیے؟ ہاں ایک ہی کتنے کا ہے؟ تین سو پچاس کا ہے جی ایس ٹی انکلودیڈ"
      },
      {
        "id": 2,
        "speaker": "A",
        "start": 24.308,
        "end": 25.008,
        "text": "Theek hai."
      },
      {
        "id": 3,
        "speaker": "A",
        "start": 25.858,
        "end": 27.958,
        "text": "Normal usb wala he na?"
      },
      {
        "id": 4,
        "speaker": "A",
        "start": 29.158,
        "end": 41.757999999999996,
        "text": "Mere laptop me wahi port hai. Ji, Normal usb connector hai. Ye dekhiye, box pe bhi diya hai. Haan, yahi chahiye. Iska bill bana dijiye."
      },
      {
        "id": 5,
        "speaker": "A",
        "start": 42.808,
        "end": 43.007999999999996,
        "text": "Ji,"
      },
      {
        "id": 6,
        "speaker": "A",
        "start": 43.858000000000004,
        "end": 45.608000000000004,
        "text": "bill kis naam se banaun?"
      },
      {
        "id": 7,
        "speaker": "A",
        "start": 46.558,
        "end": 68.4,
        "text": "Amit Sharma. Payment u p i se karunga. ye counter wala kyu aar scan kar lijiye. Amount teen so pachas hai kar diya. ye dekhiye. Successful aa gaya haan ji. Payment aa de. ye aapka Mouse aur Bill."
      },
      {
        "id": 8,
        "speaker": "A",
        "start": 69.45,
        "end": 71.5,
        "text": "theek hai Thank you."
      },
      {
        "id": 9,
        "speaker": "A",
        "start": 80.842,
        "end": 83.142,
        "text": "ji bataye kya dikhaun"
      },
      {
        "id": 10,
        "speaker": "B",
        "start": 83.592,
        "end": 92.142,
        "text": "type si wale taar ke earphone chahiye pandra so ke andar call par aawaz saaf aani chahiye"
      },
      {
        "id": 11,
        "speaker": "A",
        "start": 93.092,
        "end": 100.392,
        "text": "ye dekhiye barah sau ninyanve ke hai ismein mic bhi hai aapka phone kaunsa hai"
      },
      {
        "id": 12,
        "speaker": "B",
        "start": 100.942,
        "end": 104.49199999999999,
        "text": "yahi phone hai laga kar dekh sakta hoon"
      },
      {
        "id": 13,
        "speaker": "A",
        "start": 105.706,
        "end": 110.706,
        "text": "haan ji, ye jaanchne wala piece hai lagaiye, aawaz aa rahi hai?"
      },
      {
        "id": 14,
        "speaker": "B",
        "start": 111.756,
        "end": 116.90599999999999,
        "text": "aawaz to aa rahi hai lekin kaan mein thoda dheela lag raha hai,"
      },
      {
        "id": 15,
        "speaker": "B",
        "start": 117.856,
        "end": 119.006,
        "text": "kuch aur achha hai?"
      },
      {
        "id": 16,
        "speaker": "A",
        "start": 120.70599999999999,
        "end": 132.084,
        "text": "isi tarah ke ye doosre hain gyarah so ninyanve mein rubber wali tip hai pehen kar dekh lijiye. aapko theek baigte hai ya nahi."
      },
      {
        "id": 17,
        "speaker": "B",
        "start": 133.534,
        "end": 138.334,
        "text": "haan, ye theek baith rahe hai iska mic bhi jaanch loon?"
      },
      {
        "id": 18,
        "speaker": "A",
        "start": 138.784,
        "end": 143.934,
        "text": "bilkul. phone mein thodi aawaz record karke sun lijiye."
      },
      {
        "id": 19,
        "speaker": "B",
        "start": 145.334,
        "end": 149.584,
        "text": "haan, aawaz saaf hai, ise mein kaala rang milega?"
      },
      {
        "id": 20,
        "speaker": "A",
        "start": 150.434,
        "end": 153.934,
        "text": "ji, kaala hai ye raha iska band dibba."
      },
      {
        "id": 21,
        "speaker": "B",
        "start": 154.804,
        "end": 155.504,
        "text": "theek hai,"
      },
      {
        "id": 22,
        "speaker": "B",
        "start": 156.304,
        "end": 159.254,
        "text": "yahin de dijiye, bill bhi bana dena."
      },
      {
        "id": 23,
        "speaker": "A",
        "start": 160.304,
        "end": 163.104,
        "text": "ji, gyarah so ninyanve hue,"
      },
      {
        "id": 24,
        "speaker": "A",
        "start": 164.254,
        "end": 165.554,
        "text": "bhuktaan kaise karenge?"
      },
      {
        "id": 25,
        "speaker": "B",
        "start": 166.804,
        "end": 170.154,
        "text": "phone se kar deta hoon, code dikha dijiye."
      },
      {
        "id": 26,
        "speaker": "A",
        "start": 178.712,
        "end": 183.112,
        "text": "Hi, I need a basic wired mouse, something under five hundred."
      },
      {
        "id": 27,
        "speaker": "A",
        "start": 184.262,
        "end": 191.112,
        "text": "Yes, this one is four hundred ninety nine rupees, standard usb connection, left and right buttons, scroll wheel."
      },
      {
        "id": 28,
        "speaker": "A",
        "start": 193.512,
        "end": 205.62,
        "text": "It'll work with my office laptop, right? It has the regular usb port. Yes, just plug it in, no separate software needed. You can check the grip on this display piece."
      },
      {
        "id": 29,
        "speaker": "C",
        "start": 206.37,
        "end": 208.92,
        "text": "Feels fine. Please bill this one."
      },
      {
        "id": 30,
        "speaker": "A",
        "start": 209.77,
        "end": 217.97,
        "text": "Before I bill it, would you consider this wireless model at eight hundred ninety nine rupees? Less cable clutter, especially if you're carrying the laptop around."
      },
      {
        "id": 31,
        "speaker": "C",
        "start": 219.02,
        "end": 226.07,
        "text": "No, thanks; it's mostly for my desk. The four hundred ninety nine rupee one is enough."
      },
      {
        "id": 32,
        "speaker": "A",
        "start": 226.94,
        "end": 235.69,
        "text": "Understood; but the wireless one is also more compact, and the receiver stores inside it. For four hundred rupees extra would you like to take that instead?"
      },
      {
        "id": 33,
        "speaker": "C",
        "start": 236.69,
        "end": 242.59,
        "text": "No, please, I said I want the wired one. I'm keeping this under five hundred."
      },
      {
        "id": 34,
        "speaker": "A",
        "start": 243.69,
        "end": 249.59,
        "text": "Sorry, I'll bill the wired one only. Total is four hundred ninety nine rupees including tax."
      },
      {
        "id": 35,
        "speaker": "C",
        "start": 250.34,
        "end": 252.89000000000001,
        "text": "Okay, can I pay by u p i?"
      },
      {
        "id": 36,
        "speaker": "A",
        "start": 254.228,
        "end": 259.778,
        "text": "Yes, please scan this qr code. Check that the amount shows four hundred ninety nine rupees."
      },
      {
        "id": 37,
        "speaker": "C",
        "start": 261.128,
        "end": 263.378,
        "text": "Done. It's showing successful."
      },
      {
        "id": 38,
        "speaker": "A",
        "start": 264.678,
        "end": 267.228,
        "text": "Received. Here's your mouse and the bill."
      }
    ],
