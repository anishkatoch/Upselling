{
  "transcript": {
    "duration": 392.21,
    "segments": [
      {
        "id": 0,
        "speaker": "A",
        "start": 0.0,
        "end": 2.999999999999999,
        "text": "Namaste, sir! batayiye kya dikhaun?"
      },
      {
        "id": 1,
        "speaker": "B",
        "start": 4.299999999999999,
        "end": 9.850000000000001,
        "text": "Pandra hazar takka phone chahiye; ek sau athais g b storagevala dikhana."
      },
      {
        "id": 2,
        "speaker": "A",
        "start": 10.750000000000002,
        "end": 21.900000000000002,
        "text": "Ji, ye model dekhiye, chaudah hazar nau sau ninyanve ka hai. Ismein chhe GB RAM aur ek sau athais GB storage hai."
      },
      {
        "id": 3,
        "speaker": "B",
        "start": 22.921999999999997,
        "end": 28.272,
        "text": "Battery kaisi hain? Mera zyada tar phone aur whatsapp hi chalta hai."
      },
      {
        "id": 4,
        "speaker": "B",
        "start": 29.471999999999998,
        "end": 32.372,
        "text": "Paanch hazaar m h ki battery hai."
      },
      {
        "id": 5,
        "speaker": "B",
        "start": 33.222,
        "end": 41.522,
        "text": "Aapke is istemal mein aam tar par din nikal jana chahiye. Baaki network aur istemal par bhi nirbhar karega."
      },
      {
        "id": 6,
        "speaker": "B",
        "start": 42.772,
        "end": 47.672,
        "text": "Theek hai, yahi pack kar dijiye. Meelay rang mein hai naa?"
      },
      {
        "id": 7,
        "speaker": "A",
        "start": 48.372,
        "end": 62.822,
        "text": "ji, neela hai iske saath cover aur tempered glass ka combo bhi le sakte hain alag alag lenge to dono ke nauson rupaye hai phone ke saath dono chhaison mein padenge lada kar bhi de denge nahi"
      },
      {
        "id": 8,
        "speaker": "B",
        "start": 62.822,
        "end": 68.77199999999999,
        "text": "chhaison mein cover aur glass dono ladane ka alag se to nahi lagega?"
      },
      {
        "id": 9,
        "speaker": "A",
        "start": 69.672,
        "end": 78.526,
        "text": "nahi sir chhaison mein dono hai aur ladana bhi shamil hai Phone mila kar kul pandrah hazar paanch sau ninyaanve honge."
      },
      {
        "id": 10,
        "speaker": "B",
        "start": 79.276,
        "end": 86.226,
        "text": "Chalo, theek hai, dono dedo. Waise bhi cover aur glass baadme lene hi padte."
      },
      {
        "id": 11,
        "speaker": "A",
        "start": 86.926,
        "end": 91.376,
        "text": "Cover mein paardarshi wala rakhoon, ya ye kaala wala?"
      },
      {
        "id": 12,
        "speaker": "B",
        "start": 92.376,
        "end": 97.27600000000001,
        "text": "Kala wala lada dijiye ... pakad bhi theek lag rahi hai iski."
      },
      {
        "id": 13,
        "speaker": "A",
        "start": 97.62,
        "end": 107.47,
        "text": "ji sir, bill mein foam aur chhai so wala combo dono daal diya hai, kul pandrah hazaar paachcho ninyanve, bhugtaan kaise karenge?"
      },
      {
        "id": 14,
        "speaker": "B",
        "start": 108.57000000000001,
        "end": 113.22,
        "text": "u pee aayi kar deta hoon aap tab tak glass laga dijiye"
      },
      {
        "id": 15,
        "speaker": "B",
        "start": 122.28200000000001,
        "end": 126.682,
        "text": "hello ji, tee vee dekh rahe hain? kya size aur budget socha hai?"
      },
      {
        "id": 16,
        "speaker": "C",
        "start": 128.032,
        "end": 135.532,
        "text": "Forty three inch smart T_V_ chahiye! budget thirty thousand tak hai-mosli netflix aur cricket ke liye."
      },
      {
        "id": 17,
        "speaker": "B",
        "start": 136.582,
        "end": 147.482,
        "text": "ji, ye forty tree inch led aapke budget mein hai, athais hazaar nausan nabbe ka netflix aur baaki streaming apps hain, remote bhi try kar lijiye."
      },
      {
        "id": 18,
        "speaker": "C",
        "start": 148.394,
        "end": 149.694,
        "text": "theek lag raha hai,"
      },
      {
        "id": 19,
        "speaker": "C",
        "start": 150.494,
        "end": 155.644,
        "text": "sahab se dekhne par picture thodi halki lag rahi hai ya showroom ki light hai"
      },
      {
        "id": 20,
        "speaker": "A",
        "start": 156.494,
        "end": 173.994,
        "text": "light ka bhi effect hai, lekin side angle se color thoda change hota hai ismein. aap chahen to yeh premium taintalis inch kyu l ee bee consider kar sakte hain, chaubees hazaar nauso nabbe ka. iska side angle view aur colors better hai. dono par same video chala deta hoon."
      },
      {
        "id": 21,
        "speaker": "C",
        "start": 174.606,
        "end": 179.406,
        "text": "Six thousand extra hai!\" Picture ke alawa kya difference hai?"
      },
      {
        "id": 22,
        "speaker": "A",
        "start": 181.356,
        "end": 193.656,
        "text": "Is model mein speakers bhi better hain aur menu thoda faster respond karta hai. Apps dono mein same milenge. Aapke Netflix aur Cricket dono basic wale par bhi chal jayenge."
      },
      {
        "id": 23,
        "speaker": "C",
        "start": 195.906,
        "end": 198.456,
        "text": "Picture ka difference to dikh raha hai!"
      },
      {
        "id": 24,
        "speaker": "C",
        "start": 199.36,
        "end": 203.71,
        "text": "bas budget badhana padega; ek minute sochne do."
      },
      {
        "id": 25,
        "speaker": "A",
        "start": 203.96,
        "end": 210.76,
        "text": "haan ji, aaram se, main dono par cricket laga deta hoon, aap sofawali distance se dekh lijiye."
      },
      {
        "id": 26,
        "speaker": "C",
        "start": 211.01,
        "end": 220.86,
        "text": "achha, premium wala hi le leta hoon ghar mein site par bhi seating hai, to wo difference kaam aayega. bill bana dijiye."
      },
      {
        "id": 27,
        "speaker": "A",
        "start": 221.404,
        "end": 229.654,
        "text": "ji, iske saath optional too ear extended warranty bhi hai-teen hazaar ki jo standard van ear warranty ke baad shuru hogi."
      },
      {
        "id": 28,
        "speaker": "A",
        "start": 230.454,
        "end": 235.454,
        "text": "total satrah hazaar nauso ninyanve ho jayega. uska cover bhi dekhna chahenge?"
      },
      {
        "id": 29,
        "speaker": "C",
        "start": 236.304,
        "end": 240.604,
        "text": "us mein panel cover hai aur galti se screen toot gayi to?"
      },
      {
        "id": 30,
        "speaker": "A",
        "start": 241.054,
        "end": 246.154,
        "text": "is plan mein panel ka electrical ya mechanical fault covered hai."
      },
      {
        "id": 31,
        "speaker": "B",
        "start": 246.644,
        "end": 257.594,
        "text": "Terms ke hisaab se-Accidental breakage or liquid damage gavar nahi hai-ye coverage sheet hai-exclusions or claim process yahin likhe hain-"
      },
      {
        "id": 32,
        "speaker": "C",
        "start": 257.994,
        "end": 270.994,
        "text": "haan, ek minute; theek hai, samajh gaya; warranty bhi add kar do; tee vee aur warranty ka total saitees hazaar nauso na nabe, right; main card se kar doonga."
      },
      {
        "id": 33,
        "speaker": "A",
        "start": 279.246,
        "end": 282.846,
        "text": "Namasteji, batayiye, kaun sa phone dekhna hai?"
      },
      {
        "id": 34,
        "speaker": "B",
        "start": 283.846,
        "end": 290.746,
        "text": "Kal jo solah hazaar wala phone dekha tha, wahi lena hai. Ek sau athaees GB wala neele rang mein."
      },
      {
        "id": 35,
        "speaker": "A",
        "start": 291.246,
        "end": 294.64599999999996,
        "text": "Ji, ye raha. Neela rang upalabd hai."
      },
      {
        "id": 36,
        "speaker": "A",
        "start": 295.496,
        "end": 298.39599999999996,
        "text": "Keemat pandrah hazaar nau sau navve hai."
      },
      {
        "id": 37,
        "speaker": "B",
        "start": 299.346,
        "end": 304.688,
        "text": "Seal pack nikal do? Haan, nikal dijiye. bas yahi phone chahiye."
      },
      {
        "id": 38,
        "speaker": "B",
        "start": 305.488,
        "end": 310.688,
        "text": "iske saath wireless earbuds bhi le lijiye. chauda so ninyanve ke hai."
      },
      {
        "id": 39,
        "speaker": "B",
        "start": 311.488,
        "end": 314.188,
        "text": "call karne aur gaane sunne mein kaam aayenge."
      },
      {
        "id": 40,
        "speaker": "B",
        "start": 315.038,
        "end": 319.238,
        "text": "nahi, earbuds nahi chahiye, phone par hi kaafi kharch ho raha hai."
      },
      {
        "id": 41,
        "speaker": "A",
        "start": 319.83799999999997,
        "end": 328.238,
        "text": "achha, ek sasta wala bhi hai. wo saat so ninyanve ka padega. budget ki waze se mana kar rahe hain to wo laga do."
      },
      {
        "id": 42,
        "speaker": "B",
        "start": 329.134,
        "end": 334.834,
        "text": "arey nahi bhaiya, mere paas pehle se hai koi bhi earbuds mat jodna"
      },
      {
        "id": 43,
        "speaker": "A",
        "start": 336.134,
        "end": 346.634,
        "text": "theek hai ji, ear buds nahi jodunga, bas screen par tempered glass lagwa lijiye, ek so ninyanve ka hai, nadane ka alag se kuch nahi lagega"
      },
      {
        "id": 44,
        "speaker": "B",
        "start": 347.184,
        "end": 352.434,
        "text": "chalo ek saun ninyanve wala glass lada do uske alawa kuch nahi chahiye"
      },
      {
        "id": 45,
        "speaker": "B",
        "start": 353.5,
        "end": 361.2,
        "text": "ji, sirf phone aur ek tempered glass, kul solah hazaar ek sau athanve rupaye hue"
      },
      {
        "id": 46,
        "speaker": "B",
        "start": 362.0,
        "end": 378.55,
        "text": "theek hai upi kar deta hoon glass seedha lagaiyega, bulbule na reh jayen. ji, ye code scan kar lijiye, aapke saamne hi glass lagakar dikha deta hoon, phir phone aur bill saath rakh doonga."
      },
      {
        "id": 47,
        "speaker": "B",
        "start": 379.594,
        "end": 383.494,
        "text": "Hol gaya payment-ha! Bill dibbe mein hi rakh dena."
      }
    ],
