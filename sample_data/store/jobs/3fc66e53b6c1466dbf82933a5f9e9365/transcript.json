{
  "transcript": {
    "duration": 281.97,
    "segments": [
      {
        "id": 0,
        "speaker": "A",
        "start": 0.02,
        "end": 2.22,
        "text": "Hello, sir; what are you looking for?"
      },
      {
        "id": 1,
        "speaker": "B",
        "start": 3.32,
        "end": 7.919999999999999,
        "text": "Do you have the Logitech b one hundred wired mouse? I need one in black."
      },
      {
        "id": 2,
        "speaker": "A",
        "start": 9.62,
        "end": 13.22,
        "text": "Yes, black is available-one minute, I'll get it from the shelf."
      },
      {
        "id": 3,
        "speaker": "B",
        "start": 14.57,
        "end": 15.719999999999999,
        "text": "What's the price?"
      },
      {
        "id": 4,
        "speaker": "A",
        "start": 16.72,
        "end": 20.42,
        "text": "It's three hundred forty nine rupees, including gst."
      },
      {
        "id": 5,
        "speaker": "B",
        "start": 22.67,
        "end": 26.720000000000002,
        "text": "This has the regular u s b connector, right, not type c?"
      },
      {
        "id": 6,
        "speaker": "A",
        "start": 27.945999999999998,
        "end": 33.596,
        "text": "Correct, sir; it has a u s b a connector; you can see it here on the box."
      },
      {
        "id": 7,
        "speaker": "B",
        "start": 34.646,
        "end": 37.296,
        "text": "Okay; that's the one I need, please bill it."
      },
      {
        "id": 8,
        "speaker": "A",
        "start": 38.046,
        "end": 40.196,
        "text": "Sure; how would you like to pay?"
      },
      {
        "id": 9,
        "speaker": "B",
        "start": 41.146,
        "end": 44.046,
        "text": "u p i. Shall I scan this code on the counter?"
      },
      {
        "id": 10,
        "speaker": "A",
        "start": 44.995999999999995,
        "end": 49.646,
        "text": "Yes, that one; the amount is three hundred forty nine rupees."
      },
      {
        "id": 11,
        "speaker": "B",
        "start": 50.596000000000004,
        "end": 52.346000000000004,
        "text": "Done, it's showing successful."
      },
      {
        "id": 12,
        "speaker": "A",
        "start": 53.084,
        "end": 56.784,
        "text": "Received, Sir, here's your mouse and the bill."
      },
      {
        "id": 13,
        "speaker": "B",
        "start": 57.934,
        "end": 58.734,
        "text": "Thank you."
      },
      {
        "id": 14,
        "speaker": "A",
        "start": 66.534,
        "end": 69.334,
        "text": "Hello, Sir, what are you looking for?"
      },
      {
        "id": 15,
        "speaker": "B",
        "start": 70.334,
        "end": 76.534,
        "text": "A phone for my father, under twenty thousand, mainly calls, WhatsApp and some videos."
      },
      {
        "id": 16,
        "speaker": "A",
        "start": 79.156,
        "end": 84.10600000000001,
        "text": "Okay-any particular brand or shall I show you something with a bigger screen?"
      },
      {
        "id": 17,
        "speaker": "B",
        "start": 84.656,
        "end": 91.156,
        "text": "Brand is flexible; yes, a big screen and decent battery, nothing complicated."
      },
      {
        "id": 18,
        "speaker": "A",
        "start": 92.30600000000001,
        "end": 99.506,
        "text": "This one is eighteen thousand five hundred-here's the display piece-you can check the screen and how it feels in the hand."
      },
      {
        "id": 19,
        "speaker": "B",
        "start": 100.206,
        "end": 105.91999999999999,
        "text": "Screen looks fine, but it's a little heavy. Anything else good?"
      },
      {
        "id": 20,
        "speaker": "A",
        "start": 106.86999999999999,
        "end": 113.11999999999999,
        "text": "Yes, this other model is nineteen thousand; it's lighter and the screen is almost the same size; have a look."
      },
      {
        "id": 21,
        "speaker": "B",
        "start": 113.77,
        "end": 117.11999999999999,
        "text": "This feels better. Can the text be made bigger?"
      },
      {
        "id": 22,
        "speaker": "A",
        "start": 118.32,
        "end": 123.27,
        "text": "Yes, sir; under Display Settings you can increase the font size like this."
      },
      {
        "id": 23,
        "speaker": "B",
        "start": 123.914,
        "end": 129.164,
        "text": "Good! and nineteen thousand is the final price, including gst."
      },
      {
        "id": 24,
        "speaker": "A",
        "start": 129.714,
        "end": 133.464,
        "text": "Yes, including gst; that's the price for the phone."
      },
      {
        "id": 25,
        "speaker": "B",
        "start": 135.214,
        "end": 137.864,
        "text": "Okay, I'll take this one. Do you have it in black?"
      },
      {
        "id": 26,
        "speaker": "A",
        "start": 138.614,
        "end": 144.414,
        "text": "Yes, black is available. I'll bring a sealed box. Shall I make the bill in your name?"
      },
      {
        "id": 27,
        "speaker": "B",
        "start": 145.614,
        "end": 148.614,
        "text": "Yes, please; I'll give you the details."
      },
      {
        "id": 28,
        "speaker": "A",
        "start": 157.514,
        "end": 160.064,
        "text": "Hello, sir; kyade kaun apko?"
      },
      {
        "id": 29,
        "speaker": "C",
        "start": 161.214,
        "end": 169.16400000000002,
        "text": "Office work ke liye lap top chahiye Excel, video calls bas normal use hai, budget forty five thousand tak hai."
      },
      {
        "id": 30,
        "speaker": "A",
        "start": 170.114,
        "end": 182.614,
        "text": "Ye wala dekh lijiye, sir sixteen g b ram, paanch baar of gap s s d hai, apke kaam ke liye sahi rahega, price forty two thousand nine ninety hai."
      },
      {
        "id": 31,
        "speaker": "C",
        "start": 183.214,
        "end": 187.664,
        "text": "Keyboard try kar sakta hoon. Kaafi typing rehti hai meree."
      },
      {
        "id": 32,
        "speaker": "A",
        "start": 188.314,
        "end": 194.614,
        "text": "Haan bilkul, baith ke check kar lijiye. Yeh document khula hai, isme type karke dekh sakte hain."
      },
      {
        "id": 33,
        "speaker": "C",
        "start": 195.264,
        "end": 200.264,
        "text": "Haan, comfortable hai, theek hai, yahi laptop le leta hoon."
      },
      {
        "id": 34,
        "speaker": "A",
        "start": 201.714,
        "end": 207.064,
        "text": "Sir, iske saath laptop bag aur wireless mouse ka optional combo bhi hai."
      },
      {
        "id": 35,
        "speaker": "A",
        "start": 207.924,
        "end": 212.47400000000002,
        "text": "Alexa bag twelve ninety nine or mouse seven ninety nine ka hai."
      },
      {
        "id": 36,
        "speaker": "A",
        "start": 213.374,
        "end": 217.22400000000002,
        "text": "Laptop ke saath dono lenge to fourteen ninety nine mein padenge."
      },
      {
        "id": 37,
        "speaker": "A",
        "start": 218.22400000000002,
        "end": 219.374,
        "text": "Five ninety nine bach jayenge."
      },
      {
        "id": 38,
        "speaker": "C",
        "start": 220.324,
        "end": 224.97400000000002,
        "text": "Bag dikhao zara, aur combo mila ke final kitna hoga?"
      },
      {
        "id": 39,
        "speaker": "A",
        "start": 226.274,
        "end": 236.968,
        "text": "Ye raha bag. Laptop is padded section mein aayega. Laptop aur combo milaake, forty four thousand four eighty nine hoga, gst included."
      },
      {
        "id": 40,
        "speaker": "C",
        "start": 237.768,
        "end": 245.418,
        "text": "Achha, budget ke andar hi hai. Bag bhi theek lag raha hai. Haan, mouse aur bag wala combo add kar do."
      },
      {
        "id": 41,
        "speaker": "A",
        "start": 245.968,
        "end": 249.018,
        "text": "Ji sir, bill kis naam se banaana hai?"
      },
      {
        "id": 42,
        "speaker": "C",
        "start": 249.518,
        "end": 253.268,
        "text": "Raffle Sharma, payment card se karunga."
      },
      {
        "id": 43,
        "speaker": "A",
        "start": 254.268,
        "end": 266.722,
        "text": "Sure sir. Bill, main laptop or discounted combo, dono listed hain. Total forty four thousand four eighty nine hay. Machine pay amount check karke card insert kardi jiye."
      },
      {
        "id": 44,
        "speaker": "C",
        "start": 267.672,
        "end": 273.072,
        "text": "Haan, amount sahi hai! Payment ho gaya. Bill bag mein rakh dena, please."
      }
    ],
