{
  "transcript": {
    "duration": 300.37,
    "segments": [
      {
        "id": 0,
        "speaker": "A",
        "start": 0.0,
        "end": 3.05,
        "text": "Hello, sir; what are you looking for?"
      },
      {
        "id": 1,
        "speaker": "B",
        "start": 4.7,
        "end": 9.350000000000001,
        "text": "I need a basic wired mouse for my laptop-something under five hundred rupees."
      },
      {
        "id": 2,
        "speaker": "A",
        "start": 10.55,
        "end": 15.95,
        "text": "Sure; your laptop has the regular usb port, or only type c?"
      },
      {
        "id": 3,
        "speaker": "B",
        "start": 16.65,
        "end": 20.4,
        "text": "Regular usb-just a simple mouse is enough."
      },
      {
        "id": 4,
        "speaker": "A",
        "start": 21.099999999999998,
        "end": 27.149999999999995,
        "text": "This one is three hundred ninety nine rupees, wired, with the regular usb connector."
      },
      {
        "id": 5,
        "speaker": "B",
        "start": 28.188,
        "end": 30.637999999999998,
        "text": "It will work with Windows eleven, right?"
      },
      {
        "id": 6,
        "speaker": "A",
        "start": 31.588,
        "end": 36.838,
        "text": "Yes, sir; just plug it in-no separate installation needed."
      },
      {
        "id": 7,
        "speaker": "B",
        "start": 37.588,
        "end": 40.188,
        "text": "Can you check it once before I take it?"
      },
      {
        "id": 8,
        "speaker": "A",
        "start": 41.438,
        "end": 49.888000000000005,
        "text": "Yes, I'll connect it to our laptop here-see, the pointer is moving-and both buttons and the scroll wheel are working."
      },
      {
        "id": 9,
        "speaker": "B",
        "start": 51.028,
        "end": 53.827999999999996,
        "text": "Okay, this is fine; I'll take it."
      },
      {
        "id": 10,
        "speaker": "A",
        "start": 54.278,
        "end": 58.827999999999996,
        "text": "That will be three hundred ninety nine, cash or u p i"
      },
      {
        "id": 11,
        "speaker": "B",
        "start": 60.228,
        "end": 63.578,
        "text": "u p i I've scanned the code. Payment is done."
      },
      {
        "id": 12,
        "speaker": "A",
        "start": 65.378,
        "end": 68.728,
        "text": "Received, sir; here's your mouse and the bill."
      },
      {
        "id": 13,
        "speaker": "B",
        "start": 70.02799999999999,
        "end": 70.52799999999999,
        "text": "Thank you."
      },
      {
        "id": 14,
        "speaker": "A",
        "start": 79.508,
        "end": 96.908,
        "text": "bhaiya, pandr hazaar ke andar phone dikhana roz ke istimaal ke liye chahiye ji camera zyada istimaal karte hain ya battery achhi chahiye battery achhi ho baaki whatsapp video aur thodi photo bas"
      },
      {
        "id": 15,
        "speaker": "A",
        "start": 98.30799999999999,
        "end": 132.562,
        "text": "ye wala dekhiye tera hazaar nau sau ninyanve ka hai paanch hazaar ki battery hai chha gb ram aur ek so athais gb storage theek hai aur kuch achha hai isi budget mein koi doosra phone dikhao haan ji ye doosra model hai iska bhi wahi daam hai ram aur storage barabar hai bas screen thodi chhoti hai aur haath mein halka lagta hai iski battery bhi utni hi hai ya kam hai?"
      },
      {
        "id": 16,
        "speaker": "A",
        "start": 134.262,
        "end": 141.662,
        "text": "ismein bhi paanch hazaar ki hai, aapke bataye istemaal mein dono ki battery kareeb ek jaisi chalegi."
      },
      {
        "id": 17,
        "speaker": "A",
        "start": 142.71200000000002,
        "end": 145.162,
        "text": "dono jara haath mein lekar dekhloon"
      },
      {
        "id": 18,
        "speaker": "A",
        "start": 147.412,
        "end": 161.146,
        "text": "bilkul, ye lijiye, dono chalu hain, screen bhi istemaal karke dekh lijiye. DUSRA WALA HAATH MEIN THEEK LAG RAHA HAI, YAHEEN NEELA RANG MEIN DE DO, BIL BANA DENA."
      },
      {
        "id": 19,
        "speaker": "A",
        "start": 162.046,
        "end": 165.89600000000002,
        "text": "JI NEELA RANG HAI, BILL KIS NAAM SE BANAAON?"
      },
      {
        "id": 20,
        "speaker": "A",
        "start": 166.946,
        "end": 170.546,
        "text": "AMIT SHARMA, PAISA YOOPI I SE KAR DOONGA."
      },
      {
        "id": 21,
        "speaker": "A",
        "start": 172.046,
        "end": 173.546,
        "text": "THEEK HAI, AMIT JI,"
      },
      {
        "id": 22,
        "speaker": "A",
        "start": 174.39600000000002,
        "end": 183.032,
        "text": "KUL TERAH HAZAR NAU SAU NINYANVE RUPEYE HAIN. yeh raha bhogtaan ka code main aapka dibba nikal deta hoon"
      },
      {
        "id": 23,
        "speaker": "A",
        "start": 190.332,
        "end": 194.982,
        "text": "namaste bhaya, bahar abhi bhi baarish ho rahi hai"
      },
      {
        "id": 24,
        "speaker": "C",
        "start": 195.93200000000002,
        "end": 203.132,
        "text": "haan, thodi halki hui hai; signal se yahan tak aane mein hi pandrah minute lag gaye"
      },
      {
        "id": 25,
        "speaker": "A",
        "start": 205.258,
        "end": 210.308,
        "text": "haan, us signal pe paani bhadh jata hai; parking mil gayi theek se"
      },
      {
        "id": 26,
        "speaker": "C",
        "start": 211.058,
        "end": 216.758,
        "text": "mil gayi, bas thoda door lagani padi chhata bhi gaari mein hi reh gaya"
      },
      {
        "id": 27,
        "speaker": "A",
        "start": 217.558,
        "end": 220.458,
        "text": "arey! tabi kandhe geele ho gaye!"
      },
      {
        "id": 28,
        "speaker": "A",
        "start": 221.258,
        "end": 224.608,
        "text": "e si seedha lag raha ho to idhar aa jaiye."
      },
      {
        "id": 29,
        "speaker": "C",
        "start": 224.90800000000002,
        "end": 231.59199999999998,
        "text": "nahi. theek ho, ek charging cable chahiye phone wali kal se kaam nahi kar rahi."
      },
      {
        "id": 30,
        "speaker": "A",
        "start": 232.59199999999998,
        "end": 241.292,
        "text": "phone me type si lagti hai aur charger ki side normal usb hai ya chotka type si port."
      },
      {
        "id": 31,
        "speaker": "C",
        "start": 242.292,
        "end": 249.492,
        "text": "phone type si hai, charger mein normal usb; ek meteri ki chahiye, teen sauke andar."
      },
      {
        "id": 32,
        "speaker": "A",
        "start": 249.84199999999998,
        "end": 254.296,
        "text": "ye usb e type si hai. ek metr,"
      },
      {
        "id": 33,
        "speaker": "A",
        "start": 255.146,
        "end": 257.39599999999996,
        "text": "do sau unchaas ki padegi."
      },
      {
        "id": 34,
        "speaker": "C",
        "start": 257.996,
        "end": 260.296,
        "text": "haan, yahi de dijiye."
      },
      {
        "id": 35,
        "speaker": "A",
        "start": 261.096,
        "end": 270.996,
        "text": "iske saath ek extra usb charger adapter bhi le lenge, chaar sau unn anve ka hai, office mein rakhne ke kaam aa jayega."
      },
      {
        "id": 36,
        "speaker": "C",
        "start": 271.39599999999996,
        "end": 278.19599999999997,
        "text": "nahi, adapter hai mere paas. sirf cable ka bill kar do, up aayi karunga."
      },
      {
        "id": 37,
        "speaker": "A",
        "start": 279.028,
        "end": 287.228,
        "text": "ji sirf cable ye kyu aar scan kar lijiye, do sau un chaas bill baiket mein rakh diya hai"
      },
      {
        "id": 38,
        "speaker": "C",
        "start": 288.12800000000004,
        "end": 291.82800000000003,
        "text": "ho gaya payment. theek hai, thank u bhaiya."
      }
    ],
