# --- secrets ---
OPENAI_API_KEY=sk-...
# Local only. On AWS the ECS task role provides credentials; leave these unset there.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- app ---
APP_ENV=local
LOG_LEVEL=INFO

# local | s3  (use s3 on AWS so API and worker share files)
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=upsell-poc
# Bucket Amazon Transcribe uses (fallback transcriber); defaults to S3_BUCKET
TRANSCRIBE_S3_BUCKET=

# inline (single process, dev) | rq (Redis queue + worker)
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

MAX_UPLOAD_MB=4096
